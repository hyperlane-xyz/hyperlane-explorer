# AWS S3 Font Storage (server-side only, used by prebuild script)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# GraphQL API backing the explorer. Defaults to the hosted API; point it at a
# self-hosted scraper (e.g. the Cardano e2e-docker stack in the monorepo) to
# browse chains that are not on the hosted deployment.
# NEXT_PUBLIC_API_URL=http://localhost:8080/v1/graphql
